{
  "uid": "iot-triggers",
  "title": "IoT Analytics Dashboard · Disparadores",
  "tags": [
    "nexodev",
    "tarea9"
  ],
  "timezone": "browser",
  "refresh": "5s",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Alertas creadas por T2 (30 min)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "iot-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "iot-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT COUNT(*) FROM alertas WHERE creada_en > NOW() - INTERVAL '30 minutes'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Lecturas descartadas por T1 (30 min)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "iot-pg"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "iot-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT COUNT(*) FROM auditoria WHERE operacion = 'RECHAZO' AND ocurrido_en > NOW() - INTERVAL '30 minutes'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "purple"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Eventos publicados en RabbitMQ (30 min)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "iot-pg"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "iot-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT COUNT(*) FROM eventos_salida WHERE publicado_en > NOW() - INTERVAL '30 minutes'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "color": {
